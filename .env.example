# Telegram
BOT_TOKEN=your_telegram_bot_token

# === ProxyAPI (рекомендуется) ===
# Ключ с https://proxyapi.ru — тот же формат, что у OpenAI SDK
PROXYAPI_ENABLED=true
PROXYAPI_API_KEY=your_proxyapi_key
# или: OPENAI_API_KEY=your_proxyapi_key
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модели (имена как у OpenAI при PROXYAPI_BASE_URL=.../openai/v1)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Чтобы ходить напрямую в OpenAI:
# PROXYAPI_ENABLED=false
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# Салон
SALON_TIMEZONE=Asia/Yekaterinburg
# ADMIN_ACCOUNTS=@your_admin,123456789

# Память / БД
DB_PATH=bookings.db
MEMORY_DIR=./memory
KNOWLEDGE_FILE=./knowledge_base/salon_strijka.txt
HISTORY_LIMIT=10

# Google Calendar (необязательно)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
