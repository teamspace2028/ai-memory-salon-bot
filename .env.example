# Telegram
BOT_TOKEN=your_telegram_bot_token

# Настройки AI (Google или OpenAI)
# Если true — запросы идут в Google AI Studio, если false — напрямую в OpenAI
USE_GOOGLE_AI=true

# Ключи и модели Google (Gemini)
GOOGLE_API_KEY=твой_ключ_от_google_ai_studio
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Ключи и модели OpenAI (используются, если USE_GOOGLE_AI=false)
OPENAI_API_KEY=твой_ключ_openai_если_есть
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Салон
SALON_TIMEZONE=Asia/Yekaterinburg
# ADMIN_ACCOUNTS=@your_admin,123456789

# Память / БД
DB_PATH=bookings.db
MEMORY_DIR=./memory
KNOWLEDGE_FILE=./knowledge_base/salon_strijka.txt
HISTORY_LIMIT=10

# Google Calendar (необязательно)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
